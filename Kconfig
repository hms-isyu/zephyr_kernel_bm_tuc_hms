    bool "Message passing via k_msgq"
    help
      src/itc/msgq/msgq.c

config BENCHMARK_TEST_ITC_PIPE_ASYNC
    bool "Message passing via k_pipe, buffered"
    help
      src/itc/pipe/pipe_async.c

config BENCHMARK_TEST_ITC_MAILBOX_SYNC
    bool "Message passing via k_mbox, synchronous"
    help
      src/itc/mailbox/mailbox_sync.c

config BENCHMARK_TEST_ITC_PIPE_SYNC
    bool "Message passing via k_pipe, bufferless"
