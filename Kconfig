config BENCHMARK_TEST_MEM_SYS_HEAP
    select BMTH_TEST_MEM_ALLOC
    bool "Allocation via sys_heap"
    help
      src/mem/sys_heap/sys_heap.c, see src/mem/sys_heap/README.md.

config BENCHMARK_TEST_MEM_K_HEAP
    select BMTH_TEST_MEM_ALLOC
    bool "Allocation via k_heap"
    help
      src/mem/k_heap/k_heap.c, see src/mem/k_heap/README.md.

config BENCHMARK_TEST_MEM_K_MALLOC
    select BMTH_TEST_MEM_ALLOC
    bool "Allocation via k_malloc"
    help
      src/mem/k_malloc/k_malloc.c, see src/mem/k_malloc/README.md.

config BENCHMARK_TEST_MEM_SLAB
    select BMTH_TEST_MEM_ALLOC
    bool "Allocation via k_mem_slab"
    help
