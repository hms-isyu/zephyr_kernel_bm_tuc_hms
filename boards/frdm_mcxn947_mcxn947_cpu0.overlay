/* J8 is the FlexIO/LCD header. Release the pads by disabling the FlexIO LCD
 * node that owns them (only actually claims them when the LCD shield is present,
 * but keep it explicit). No pinctrl group is needed for plain GPIO: the MCX GPIO
 * driver rewrites each pad's mux to FUNC0/GPIO in gpio_pin_configure(), so it
 * takes the pad regardless of any peripheral's default pinmux. */
&flexio0_lcd {
    status = "disabled";
};

/ {
    j8_connector: j8-connector {
        compatible = "nxp,gpio-nexus";
        #gpio-cells = <2>;
        gpio-map-mask = <0xffffffff 0xffffffc0>;
        gpio-map-pass-thru = <0 0x3f>;
        gpio-map = <0 0 &gpio4 16 0>,   /* J8 pin 21, LCD_D8  */
                   <1 0 &gpio4 17 0>,   /* J8 pin 22, LCD_D9  */
                   <2 0 &gpio4 18 0>,   /* J8 pin 23, LCD_D10 */
                   <3 0 &gpio4 19 0>,   /* J8 pin 24, LCD_11  */
                   <4 0 &gpio4 20 0>,   /* J8 pin 25, LCD_D12 */
                   <5 0 &gpio4 21 0>,   /* J8 pin 26, LCD_13  */
                   <6 0 &gpio4 22 0>,   /* J8 pin 27, LCD_D14 */
                   <7 0 &gpio4 23 0>;   /* J8 pin 28, LCD_D15 */
    };

    gpio_bank: gpio-bank {
        compatible = "gpio-leds";
        out0: out0 { gpios = <&j8_connector 0 GPIO_ACTIVE_HIGH>; };
        out1: out1 { gpios = <&j8_connector 1 GPIO_ACTIVE_HIGH>; };
        out2: out2 { gpios = <&j8_connector 2 GPIO_ACTIVE_HIGH>; };
        out3: out3 { gpios = <&j8_connector 3 GPIO_ACTIVE_HIGH>; };
        out4: out4 { gpios = <&j8_connector 4 GPIO_ACTIVE_HIGH>; };
        out5: out5 { gpios = <&j8_connector 5 GPIO_ACTIVE_HIGH>; };
        out6: out6 { gpios = <&j8_connector 6 GPIO_ACTIVE_HIGH>; };
        out7: out7 { gpios = <&j8_connector 7 GPIO_ACTIVE_HIGH>; };
    };
};
